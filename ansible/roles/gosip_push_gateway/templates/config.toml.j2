[sip]
listen_ip = "{{ gosip_push_gateway_sip_listen_ip }}"
listen_port = {{ gosip_push_gateway_sip_listen_port }}
public_ip = "{{ gosip_push_gateway_sip_public_ip }}"
{% if gosip_push_gateway_sip_advertise_ip != "" %}
advertise_ip = "{{ gosip_push_gateway_sip_advertise_ip }}"
{% endif %}
wake_timeout_seconds = {{ gosip_push_gateway_sip_wake_timeout_seconds }}

[freepbx]
ip = "{{ gosip_push_gateway_freepbx_ip }}"
port = {{ gosip_push_gateway_freepbx_port }}
transport = "{{ gosip_push_gateway_freepbx_transport }}"

[push.apns]
enabled = {{ gosip_push_gateway_apns_enabled | lower }}
key_path = "{{ gosip_push_gateway_apns_key_path }}"
key_id = "{{ gosip_push_gateway_apns_key_id }}"
team_id = "{{ gosip_push_gateway_apns_team_id }}"
voip_topic = "{{ gosip_push_gateway_apns_voip_topic }}"
production = {{ gosip_push_gateway_apns_production | lower }}

[push.fcm]
enabled = {{ gosip_push_gateway_fcm_enabled | lower }}
credentials_path = "{{ gosip_push_gateway_fcm_credentials_path }}"
